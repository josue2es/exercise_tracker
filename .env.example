# Gym Tracker environment (copy to .env, chmod 600, never commit).
# SQLite database file, relative to the app directory.
DATABASE_PATH=data/gym.db

# Secret used to sign browser session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_SECRET=change-me-generate-a-real-secret

# Seed admin email; on first start a one-time setup link is printed to the log.
FIRST_ADMIN_EMAIL=

# Public base URL (used for invite links and cookie security).
BASE_URL=https://gym.api-mcp.com

LOG_LEVEL=INFO

# uvicorn bind address (Caddy proxies to this).
BIND_HOST=127.0.0.1
BIND_PORT=8080

# Optional: rsync target for off-server backup copies (Hetzner VPS).
# BACKUP_RSYNC_TARGET=backup-host:/srv/backups/gym
